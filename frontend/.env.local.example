# Frontend Environment Variables
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/gachard?retryWrites=true&w=majority
DATABASE_NAME=gachard
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# AES-256-GCM encryption key (min 32 characters) — for encrypting private keys in MongoDB
ENCRYPTION_SECRET_KEY=your-32-char-min-secret-key-here!!

# Monad Testnet
ADMIN_WALLET_ADDRESS=0x...
ADMIN_PRIVATE_KEY=0x...
RPC_URL=https://testnet-rpc.monad.xyz
CHAIN_ID=10143
CONTRACT_ADDRESS=

# Pyth Entropy (for provably fair pack randomness)
# Leave ENTROPY_CONTRACT_ADDRESS empty to fallback to Math.random()
ENTROPY_CONTRACT_ADDRESS=
PYTH_ENTROPY_ADDRESS=0x825c0390f379c631f3cf11a82a37d20bddf93c07

# MiMo LLM — the app's single AI provider (ADR-030).
# Powers trade risk scoring (lib/risk-score.ts) and marketplace insight +
# price suggestion (lib/market-insight.ts). Without it both degrade to
# "AI scoring unavailable" rather than failing, so a missing key is silent.
MIMO_API_KEY=your-mimo-api-key
# Optional — these have working defaults:
# MIMO_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
# MIMO_MODEL=MiMo-V2.5-Pro

# Admin Console Basic Auth (generate random values, do NOT reuse existing credentials)
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=your-admin-password

# Enable demo account login (set to "true" to show demo button on login page)
ENABLE_DEMO_LOGIN=true

# v2 store (docs/PLAN-STORE-V2.md). Off unless CHAIN_VERSION=v2.
# For local development, the addresses come from contracts/deployments/local-v2.json
# and the relayer keys are anvil's public development keys 3 and 4.
CHAIN_VERSION=
V2_RPC_URL=
V2_CARDS=
V2_STORE=
V2_ALBUMS=
# Comma-separated private keys holding RELAYER_ROLE. Never commit real ones.
V2_RELAYER_KEYS=
# Optional: eligible cards expected per rotation, for pacing the limited card (default 300)
# V2_EXPECTED_ELIGIBLE_CARDS=
# Vercel Cron sends it as a bearer token to /api/cron/*; generate a long random value
CRON_SECRET=
