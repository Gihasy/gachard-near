# npm run setup writes .env.local for you, with a new testnet account.
# Only fill this in by hand to reuse an existing account.
NEAR_PLATFORM_ACCOUNT=your-account.testnet
NEAR_PLATFORM_KEY=ed25519:your-private-key
NEAR_CONTRACT=cards.your-account.testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
ENCRYPTION_SECRET_KEY=at-least-32-characters-of-random-text
ENABLE_DEMO_LOGIN=true
# Optional. Without it, the sign-in page offers demo accounts only.
GOOGLE_CLIENT_ID=
# Hosting only: serverless has no lasting disk. Leave empty for the local demo.
MONGODB_URL=
MONGODB_DB=gachard_near
